async function handleDepositSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById("depositSubmitBtn");
    btn.disabled = true;
    btn.textContent = "Aportando...";

    const id = document.getElementById("depositGoalId").value;
    const amount = parseFloat(document.getElementById("depositAmount").value) || 0;
    if (amount <= 0) {
        showToast("Insira um valor válido para aporte.", "error");
        btn.disabled = false;
        return;
    }

    const goal = goals.find(g => String(g.id) === String(id));
    if (!goal) return;

    const newAmount = (Number(goal.current_amount) || 0) + amount;
    const isCompleted = newAmount >= (Number(goal.target_amount) || 0);

    try {
        let isOnline = navigator.onLine && window.supabaseClient;
        if (isOnline) {
            try {
                const { error } = await supabaseClient
                    .from("goals")
                    .update({
                        current_amount: newAmount,
                        completed: isCompleted
                    })
                    .eq("id", id)
                    .eq("user_id", currentUser.id);

                if (error) throw error;

                // Registra aporte histórico em goal_deposits
                const todayStr = (typeof getToday === 'function') ? getToday() : new Date().toLocaleDateString('sv');
                await supabaseClient.from("goal_deposits").insert([{
                    goal_id: id,
                    user_id: currentUser.id,
                    amount: amount,
                    deposit_date: todayStr
                }]);
            } catch (netErr) {
                console.warn("Falha online no aporte, enfileirando offline:", netErr);
                isOnline = false;
            }
        }

        if (!isOnline) {
            goal.current_amount = newAmount;
            goal.completed = isCompleted;
            if (window.tonuSync) {
                await window.tonuSync.enqueue('UPDATE_GOAL', { id, current_amount: newAmount, completed: isCompleted });
                await window.tonuSync.setCachedGoals(currentUser.id, goals);
            }
            showToast(`📦 Aporte de ${formatCurrency(amount)} salvo offline!`, "info");
        } else {
            showToast(`Aporte de ${formatCurrency(amount)} realizado! ${isCompleted ? '🎉 Parabéns! Meta concluída!' : ''}`, "success");
        }

        closeDepositModal();
        await loadGoals();
        await checkMilestonesMobile(goal, newAmount);
    } catch (err) {
        showToast("Erro no aporte: " + err.message, "error");
    } finally {
        btn.disabled = false;
        btn.textContent = "Confirmar Aporte";
    }
}

