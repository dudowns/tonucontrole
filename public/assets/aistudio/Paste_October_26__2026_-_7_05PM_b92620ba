<script src="../../js/core.js"></script>
<script src="../../js/sync.js"></script>
<script src="../../js/sw-register.js"></script>
<script>
let currentUser = null;
let goals = [];
let currentFilter = 'all';

const CATEGORY_ICONS = {
    emergency: { icon: 'fa-shield-alt', color: '#00B894', label: 'Reserva de Emergência' },
    travel: { icon: 'fa-plane-departure', color: '#0984E3', label: 'Viagem & Lazer' },
    vehicle: { icon: 'fa-car', color: '#E17055', label: 'Veículo' },
    home: { icon: 'fa-home', color: '#6C5CE7', label: 'Imóvel / Casa' },
    education: { icon: 'fa-graduation-cap', color: '#A29BFE', label: 'Educação' },
    investment: { icon: 'fa-chart-line', color: '#10B981', label: 'Investimentos' },
    purchase: { icon: 'fa-shopping-bag', color: '#FDCB6E', label: 'Compras' },
    other: { icon: 'fa-bullseye', color: '#6C5CE7', label: 'Objetivo Geral' }
};

document.addEventListener("DOMContentLoaded", async () => {
    const savedTheme = localStorage.getItem("tonu_theme") || "light";
    if (savedTheme === "dark") {
        document.body.classList.add("dark-theme");
        document.documentElement.setAttribute("data-theme", "dark");
        document.querySelector("#themeIcon")?.classList.replace("fa-moon", "fa-sun");
    }

    try {
        let user = null;
        if (window.getAuthenticatedUser) user = await window.getAuthenticatedUser();
        if (!user && window.supabaseOffline) user = await window.supabaseOffline.isAuthenticated();
        if (!user && window.supabaseClient && window.supabaseClient.auth) {
            try {
                const { data: sessData } = await supabaseClient.auth.getSession();
                user = sessData?.session?.user;
                if (!user) {
                    const { data: userData } = await supabaseClient.auth.getUser();
                    user = userData?.user;
                }
            } catch (_) {}
        }
        if (!user) {
            try {
                const s = sessionStorage.getItem("tonu_user");
                if (s) { const p = JSON.parse(s); user = p.user || p; }
            } catch (_) {}
        }
        if (!user) {
            try {
                const off = localStorage.getItem("tonu_offline_session");
                if (off) { const p = JSON.parse(off); user = p.user || p; }
            } catch (_) {}
        }
        if (!user) { window.location.href = "../../index.html"; return; }
        currentUser = user;
        await loadGoals();
    } catch (e) {
        console.error("Erro auth mobile metas:", e);
        window.location.href = "../../index.html";
    }
});

// ============================================
// CARREGAR METAS DO SUPABASE OU CACHE LOCAL
// ============================================
async function loadGoals() {
    try {
        let loaded = false;
        if (navigator.onLine && window.supabaseClient && currentUser) {
            try {
                const { data, error } = await supabaseClient
                    .from("goals")
                    .select("*")
                    .eq("user_id", currentUser.id)
                    .order("created_at", { ascending: false });

                if (!error && data) {
                    goals = data;
                    loaded = true;
                    if (window.tonuSync) {
                        await window.tonuSync.setCachedGoals(currentUser.id, goals);
                    }
                }
            } catch (netErr) {
                console.warn("Falha de rede ao buscar metas remotas:", netErr);
            }
        }

        if (!loaded && window.tonuSync) {
            const cached = await window.tonuSync.getCachedGoals(currentUser?.id);
            if (cached && cached.length > 0) {
                goals = cached;
                loaded = true;
            }
        }

        updateHeroStats();
        renderGoals();
    } catch (error) {
        console.error("Erro ao carregar metas:", error);
        if (window.tonuSync) {
            const cached = await window.tonuSync.getCachedGoals(currentUser?.id);
            if (cached && cached.length > 0) {
                goals = cached;
                updateHeroStats();
                renderGoals();
                return;
            }
        }
        showToast("Erro ao carregar metas: " + (error.message || "Tente novamente"), "error");
    }
}

// ============================================
// ATUALIZAR ESTATÍSTICAS
// ============================================
function updateHeroStats() {
    let totalAcumulado = 0;
    let totalAlvo = 0;
    let concluidas = 0;

    goals.forEach(g => {
        const cur = Number(g.current_amount) || 0;
        const tgt = Number(g.target_amount) || 0;
        totalAcumulado += cur;
        totalAlvo += tgt;
        if (g.completed || (tgt > 0 && cur >= tgt)) {
            concluidas++;
        }
    });

    document.getElementById("heroTotalAcumulado").textContent = formatCurrency(totalAcumulado);
    document.getElementById("heroTotalAlvo").textContent = formatCurrency(totalAlvo);
    document.getElementById("heroMetasConcluidas").textContent = `${concluidas} de ${goals.length}`;
    if (typeof updateMobileCdiGlobalCard === 'function') updateMobileCdiGlobalCard();
}

// ============================================
// RENDERIZAR LISTA DE METAS COM CARDS & AÇÕES
// ============================================
function renderGoals() {
    const container = document.getElementById("goalsContainer");
    if (!container) return;

    let filtered = goals;
    if (currentFilter === 'ongoing') {
        filtered = goals.filter(g => !g.completed && (Number(g.current_amount) || 0) < (Number(g.target_amount) || 0));
    } else if (currentFilter === 'completed') {
        filtered = goals.filter(g => g.completed || (Number(g.current_amount) || 0) >= (Number(g.target_amount) || 0));
    }

    if (filtered.length === 0) {
        container.innerHTML = `
            <div style="text-align:center; padding:32px 16px; background:var(--color-surface,#fff); border-radius:14px; border:1px solid var(--color-border,#e2e8f0);">
                <i class="fas fa-bullseye" style="font-size:36px; color:#a29bfe; margin-bottom:10px; display:block;"></i>
                <h3 style="font-size:14px; font-weight:700; color:var(--color-text,#0f172a); margin-bottom:4px;">Nenhuma meta encontrada</h3>
                <p style="font-size:12px; color:#94a3b8; margin-bottom:14px;">Defina um objetivo financeiro e acompanhe seu progresso!</p>
                <button class="btn-add-primary" style="margin:0 auto;" onclick="openGoalModal()">
                    <i class="fas fa-plus"></i> Criar Primeira Meta
                </button>
            </div>
        `;
        return;
    }

    container.innerHTML = filtered.map(g => {
        const goalType = g.type || 'financial';
        const catInfo = CATEGORY_ICONS[g.category] || CATEGORY_ICONS.other;
        const color = g.color || catInfo.color;

        // TIPO 1: PROJETO / HÁBITO MOBILE (📌)
        if (goalType === 'habit') {
            const isCompleted = !!g.completed;
            const completedDateText = g.completed_at ? formatDate(g.completed_at) : (g.deadline ? formatDate(g.deadline) : null);

            return `
                <div class="goal-card ${isCompleted ? 'completed' : ''}" style="border-left-color:${isCompleted ? '#10b981' : color};">
                    <div class="goal-card-top">
                        <div class="goal-title-group">
                            <div class="goal-category-icon" style="background:${isCompleted ? '#10b981' : color};">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <div>
                                <h3>${g.title}</h3>
                                <small>📌 Projeto / Hábito</small>
                            </div>
                        </div>
                        <span class="goal-badge ${isCompleted ? 'done' : 'ongoing'}">
                            <i class="fas ${isCompleted ? 'fa-check' : 'fa-hourglass-half'}"></i>
                            ${isCompleted ? 'Concluído' : 'Pendente'}
                        </span>
                    </div>

                    <div style="background:var(--color-bg,#f8fafc); border-radius:10px; padding:10px 12px; margin:8px 0; display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <span style="font-size:10px; color:#94a3b8; display:block;">Status</span>
                            <span style="font-size:13px; font-weight:700; color:${isCompleted ? '#10b981' : '#f59e0b'};">
                                ${isCompleted ? '✅ Concluído' : '⏳ Em Andamento'}
                            </span>
                        </div>
                        <div style="text-align:right;">
                            <span style="font-size:10px; color:#94a3b8; display:block;">${isCompleted ? 'Concluído em' : 'Prazo'}</span>
                            <span style="font-size:12px; font-weight:600;">${completedDateText || 'Sem prazo'}</span>
                        </div>
                    </div>

                    <div class="goal-progress-bar">
                        <div class="goal-progress-fill" style="width: ${isCompleted ? '100%' : '0%'}; background:${isCompleted ? '#10b981' : color};"></div>
                    </div>

                    <!-- AÇÕES DO HÁBITO -->
                    <div class="goal-actions-grid" style="grid-template-columns: 1fr auto auto;">
                        <button type="button" class="btn-goal-act" style="background:${isCompleted ? '#d1fae5' : 'rgba(108,92,231,0.12)'}; color:${isCompleted ? '#047857' : '#6C5CE7'}; font-weight:700;" onclick="toggleMobileHabitStatus('${g.id}')">
                            <i class="fas ${isCompleted ? 'fa-undo' : 'fa-check'}"></i> ${isCompleted ? 'Reabrir Hábito' : 'Concluir Hábito'}
                        </button>
                        <button type="button" class="btn-goal-icon" onclick="openEditGoalModal('${g.id}')" title="Editar Meta">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button type="button" class="btn-goal-icon del" onclick="deleteGoal('${g.id}')" title="Excluir Meta">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        // TIPO 2: DIVIDENDOS MOBILE (📈)
        if (goalType === 'dividends') {
            const monthlyDivs = getMonthlyDividendsTotalMobile();
            const tgt = Number(g.target_amount) || 1;
            const percent = Math.min(100, Math.round((monthlyDivs / tgt) * 100));
            const isCompleted = monthlyDivs >= tgt;

            return `
                <div class="goal-card ${isCompleted ? 'completed' : ''}" style="border-left-color:#10B981;">
                    <div class="goal-card-top">
                        <div class="goal-title-group">
                            <div class="goal-category-icon" style="background:#10B981;">
                                <i class="fas fa-hand-holding-usd"></i>
                            </div>
                            <div>
                                <h3>${g.title}</h3>
                                <small>📈 Dividendos Mensais</small>
