const IOF_TABLE_MOBILE = {
    1: 0.96, 2: 0.93, 3: 0.90, 4: 0.86, 5: 0.83,
    6: 0.80, 7: 0.76, 8: 0.73, 9: 0.70, 10: 0.66,
    11: 0.63, 12: 0.60, 13: 0.56, 14: 0.53, 15: 0.50,
    16: 0.46, 17: 0.43, 18: 0.40, 19: 0.36, 20: 0.33,
    21: 0.30, 22: 0.26, 23: 0.23, 24: 0.20, 25: 0.16,
    26: 0.13, 27: 0.10, 28: 0.06, 29: 0.03
};

function getIOFRateMobile(daysPassed) {
    if (daysPassed <= 0) return 0.96;
    if (daysPassed >= 30) return 0;
    return IOF_TABLE_MOBILE[daysPassed] !== undefined ? IOF_TABLE_MOBILE[daysPassed] : 0;
}

function getIRRateMobile(daysPassed) {
    if (daysPassed <= 180) return 0.225; // 22,5%
    if (daysPassed <= 360) return 0.200; // 20,0%
    if (daysPassed <= 720) return 0.175; // 17,5%
    return 0.150; // 15,0%
}

let cachedMobileCDIDailyRate = 0.040169; // ~10.65% a.a.

async function fetchMobileCDIRate() {
    try {
        if (window.supabaseClient && window.supabaseClient.functions) {
            const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 2500));
            const invokePromise = window.supabaseClient.functions.invoke('get-cdi');
            const res = await Promise.race([invokePromise, timeoutPromise]);
            if (res && !res.error && res.data?.cdi?.daily_rate) {
                cachedMobileCDIDailyRate = res.data.cdi.daily_rate;
                return cachedMobileCDIDailyRate;
            }
        }
    } catch (e) {
        console.warn('⚠️ Falha ou timeout ao buscar CDI via Edge Function (Mobile):', e);
    }
    return cachedMobileCDIDailyRate;
}

async function checkMilestonesMobile(goal, newAmount) {
    try {
        if (!goal) return;
        const target = Number(goal.target_amount) || 0;
        if (target <= 0) return;

        const amt = Number(newAmount) || 0;
        const pct = Math.min(100, Math.floor((amt / target) * 100));
        const milestones = [25, 50, 75, 90, 100];

        let fired = [];
        if (Array.isArray(goal.milestones_fired)) {
            fired = [...goal.milestones_fired];
        } else if (typeof goal.milestones_fired === 'string') {
            try {
                const parsed = JSON.parse(goal.milestones_fired);
                if (Array.isArray(parsed)) fired = parsed;
            } catch (e) {
                fired = [];
            }
        }

        let newFired = [];
        for (const m of milestones) {
            if (pct >= m && !fired.includes(m)) {
                fired.push(m);
                newFired.push(m);
            }
        }

        if (newFired.length > 0) {
            goal.milestones_fired = fired;
            const uid = (typeof currentUser !== 'undefined' && currentUser?.id) || window.currentUser?.id;
            if (window.supabaseClient && uid) {
                try {
                    await window.supabaseClient
                        .from('goals')
                        .update({ milestones_fired: fired })
                        .eq('id', goal.id)
                        .eq('user_id', uid);
                } catch (err) {
                    console.warn('⚠️ Erro ao persistir milestones_fired (Mobile):', err);
                }
            }

            const highestMilestone = newFired[newFired.length - 1];
            if (highestMilestone === 100) {
                if (typeof triggerCelebrationModal === 'function') {
                    triggerCelebrationModal(goal.title || 'Meta', amt);
                } else if (typeof showToast === 'function') {
                    showToast(`🎉 Parabéns! Meta "${goal.title || ''}" concluída 100%!`, 'success');
                }
            } else {
                if (typeof showToast === 'function') {
                    showToast(`🎯 Marco de ${highestMilestone}% alcançado na meta "${goal.title || ''}"! 🚀`, 'success');
                }
                if (typeof triggerGoalConfetti === 'function') {
                    triggerGoalConfetti();
                }
            }

            if (typeof window.sendRealtimePush === 'function') {
                try {
                    window.sendRealtimePush({
                        title: `🎯 Marco alcançado: ${highestMilestone}% da meta!`,
                        body: `Você conquistou ${highestMilestone}% da sua meta "${goal.title}"! Continue firme.`,
                        url: 'pages/mobile/goals.html',
                        tag: `goal-milestone-${goal.id}-${highestMilestone}`
                    });
                } catch (pushErr) {
                    console.warn('⚠️ Erro ao enviar push notification de marco:', pushErr);
                }
            }
        }
    } catch (err) {
        console.warn('⚠️ Erro não impeditivo em checkMilestonesMobile:', err);
    }
}

