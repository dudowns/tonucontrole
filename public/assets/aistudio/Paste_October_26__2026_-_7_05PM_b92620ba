async function deleteGoal(id) {
    const goal = goals.find(g => String(g.id) === String(id));
    if (!goal) return;

    if (!confirm(`Deseja realmente excluir a meta "${goal.title}"?`)) return;

    try {
        let isOnline = navigator.onLine && window.supabaseClient;
        if (isOnline) {
            try {
                const { error } = await supabaseClient
                    .from("goals")
                    .delete()
                    .eq("id", id)
                    .eq("user_id", currentUser.id);

                if (error) throw error;
            } catch (netErr) {
                console.warn("Falha online na exclusão, enfileirando offline:", netErr);
                isOnline = false;
            }
        }

        if (!isOnline) {
            goals = goals.filter(g => String(g.id) !== String(id));
            if (window.tonuSync) {
                await window.tonuSync.enqueue('DELETE_GOAL', { id });
                await window.tonuSync.setCachedGoals(currentUser.id, goals);
            }
            showToast("📦 Meta excluída offline! Sincronizará quando a conexão retornar.", "info");
        } else {
            showToast("Meta excluída com sucesso!", "success");
        }

        await loadGoals();
    } catch (err) {
        showToast("Erro ao excluir: " + err.message, "error");
    }
}

