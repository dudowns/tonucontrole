async function handleGoalSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById("goalSubmitBtn");
    btn.disabled = true;
    btn.textContent = "Salvando...";

    const editId = document.getElementById("goalEditId").value;
    const type = document.getElementById("goalType")?.value || "financial";
    const title = document.getElementById("goalTitle").value.trim();
    const category = document.getElementById("goalCategory").value;
    let target = parseFloat(document.getElementById("goalTarget").value) || 0;
    let current = parseFloat(document.getElementById("goalCurrent").value) || 0;
    const deadline = document.getElementById("goalDeadline").value || null;
    const color = document.getElementById("goalColor").value;
    const cdiPercent = parseFloat(document.getElementById("goalCdiPercent")?.value) || 100;
    
    let completed = false;
    if (type === 'habit') {
        target = 1;
        current = 0;
        completed = false;
    } else if (type === 'dividends') {
        current = getMonthlyDividendsTotalMobile();
        completed = target > 0 ? (current >= target) : false;
        if (target <= 0) {
            showToast("Informe o valor mensal esperado de dividendos!", "error");
            btn.disabled = false;
            btn.textContent = "Salvar Meta";
            return;
        }
    } else {
        completed = current >= target && target > 0;
    }

    const payload = {
        user_id: currentUser.id,
        type: type,
        title: title,
        category: category,
        target_amount: target,
        current_amount: current,
        deadline: deadline,
        color: color,
        cdi_percent: cdiPercent,
        completed: completed
    };

    try {
        let isOnline = navigator.onLine && window.supabaseClient;
        if (isOnline) {
            try {
                let res;
                if (editId) {
                    res = await supabaseClient
                        .from("goals")
                        .update(payload)
                        .eq("id", editId)
                        .eq("user_id", currentUser.id);
                } else {
                    res = await supabaseClient
                        .from("goals")
                        .insert([payload]);
                }

                if (res.error && res.error.message && res.error.message.includes("category")) {
                    delete payload.category;
                    if (editId) {
                        await supabaseClient.from("goals").update(payload).eq("id", editId).eq("user_id", currentUser.id);
                    } else {
                        await supabaseClient.from("goals").insert([payload]);
                    }
                } else if (res.error) {
                    throw res.error;
                }
            } catch (netErr) {
                console.warn("Falha online, enfileirando offline:", netErr);
                isOnline = false;
            }
        }

        if (!isOnline) {
            if (editId) {
                const idx = goals.findIndex(g => String(g.id) === String(editId));
                if (idx !== -1) goals[idx] = { ...goals[idx], ...payload };
                if (window.tonuSync) {
                    await window.tonuSync.enqueue('UPDATE_GOAL', { id: editId, ...payload });
                    await window.tonuSync.setCachedGoals(currentUser.id, goals);
                }
            } else {
                const offlineId = 'offline_goal_' + Date.now();
                const newGoal = { id: offlineId, ...payload, created_at: new Date().toISOString() };
                goals.unshift(newGoal);
                if (window.tonuSync) {
                    await window.tonuSync.enqueue('INSERT_GOAL', payload);
                    await window.tonuSync.setCachedGoals(currentUser.id, goals);
                }
            }
            showToast("📦 Meta salva offline! Sincronizará quando a conexão retornar.", "info");
        } else {
            showToast(editId ? "Meta atualizada com sucesso!" : "Meta criada com sucesso!", "success");
        }

        closeGoalModal();
        await loadGoals();

        if (completed) {
            triggerCelebrationModal(title, Math.max(target, current));
        }
    } catch (err) {
        showToast("Erro ao salvar: " + err.message, "error");
    } finally {
        btn.disabled = false;
        btn.textContent = "Salvar Meta";
    }
}

