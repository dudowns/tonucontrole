async function loadCashFlow(forceRefresh = false) {
    const CACHE_KEY = `tonu_cashflow_${currentUser?.id}`;
    if (!forceRefresh) {
        try {
            const cached = sessionStorage.getItem(CACHE_KEY);
            if (cached) {
                const { data, ts } = JSON.parse(cached);
                if (Date.now() - ts < 60 * 60 * 1000) {
                    renderCashFlow(data);
                    return;
                }
            }
        } catch (_) {}
    }
    
    try {
        const { data: { session } } = await window.supabaseClient.auth.getSession();
        if (!session) return;
        
        const res = await fetch(`${window.getBaseUrl()}/api/cashflow-forecast`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${session.access_token}`
            },
            body: JSON.stringify({ days: 30 })
        });
        
        if (!res.ok) return;
        const data = await res.json();
        
        try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ data, ts: Date.now() })); } catch (_) {}
        renderCashFlow(data);
    } catch (e) {
        console.warn('[CashFlow] Falha silenciosa:', e.message);
    }
}

function renderCashFlow(data) {
    // Cards de resumo
    const summary = document.getElementById('cashflowSummary');
    if (summary && data.summary) {
        summary.innerHTML = `
            <div><small class="text-muted">Saldo Atual</small><br>
                 <strong>${formatCurrency(data.summary.current_balance)}</strong></div>
            <div><small class="text-muted">Em 30 dias</small><br>
                 <strong style="color:${data.summary.projected_balance_30d >= 0 ? '#10B981' : '#ef4444'};">
                     ${formatCurrency(data.summary.projected_balance_30d)}</strong></div>
            <div><small class="text-muted">Menor saldo</small><br>
                 <strong style="color:${data.summary.min_balance >= 500 ? '#10B981' : '#F59E0B'};">
                     ${formatCurrency(data.summary.min_balance)}</strong></div>
        `;
    }
    
    // Alerta
    const alert = document.getElementById('cashflowAlert');
    if (alert && data.summary?.risk_alert) {
        alert.innerHTML = `
            <div style="padding:10px 14px;border-radius:10px;
                        background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);
                        font-size:12.5px;color:#92400e;display:flex;gap:8px;">
                <i class="fas fa-exclamation-triangle" style="color:#F59E0B;margin-top:2px;"></i>
                <span>${data.summary.risk_alert}</span>
            </div>
        `;
    } else if (alert) {
        alert.innerHTML = '';
    }
    
    // Gráfico (Chart.js)
    const ctx = document.getElementById('cashflowChart')?.getContext('2d');
    if (!ctx || !data.daily) return;
    
    if (window._cashflowChart) window._cashflowChart.destroy();
    
    window._cashflowChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: data.daily.map(d => d.date.slice(5)),
            datasets: [{
                label: 'Saldo projetado',
                data: data.daily.map(d => d.balance),
                borderColor: '#6C5CE7',
                backgroundColor: 'rgba(108,92,231,0.1)',
                fill: true,
                tension: 0.3,
                pointRadius: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { 
                    beginAtZero: false,
                    ticks: { callback: v => 'R$ ' + v.toFixed(0) }
                }
            }
        }
    });
}

window.loadCashFlow = loadCashFlow;
