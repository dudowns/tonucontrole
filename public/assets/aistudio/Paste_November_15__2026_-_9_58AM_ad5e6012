async function loadAIInsights(forceRefresh = false) {
    const body = document.getElementById('aiInsightsBody');
    if (!body) return;
    
    // Cache local em sessionStorage (6h TTL)
    const CACHE_KEY = `tonu_ai_insights_${currentUser?.id}`;
    if (!forceRefresh) {
        try {
            const cached = sessionStorage.getItem(CACHE_KEY);
            if (cached) {
                const { data, ts } = JSON.parse(cached);
                if (Date.now() - ts < 6 * 60 * 60 * 1000) {
                    renderAIInsights(data.insights);
                    return;
                }
            }
        } catch (_) {}
    }
    
    body.innerHTML = '<div class="skeleton-shimmer" style="width:100%;height:40px;border-radius:8px;"></div>';
    
    try {
        const { data: { session } } = await window.supabaseClient.auth.getSession();
        if (!session) { body.innerHTML = ''; return; }
        
        const res = await fetch(`${window.getBaseUrl()}/api/insights`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${session.access_token}`
            },
            body: JSON.stringify({})
        });
        
        if (!res.ok) { body.innerHTML = ''; return; }
        const data = await res.json();
        if (!data.insights || data.insights.length === 0) {
            body.innerHTML = '<p class="text-muted" style="font-size:12px;">Registre mais transações para insights personalizados.</p>';
            return;
        }
        
        try {
            sessionStorage.setItem(CACHE_KEY, JSON.stringify({
                data, ts: Date.now()
            }));
        } catch (_) {}
        
        renderAIInsights(data.insights);
    } catch (e) {
        console.warn('[AI Insights] Falha silenciosa:', e.message);
        body.innerHTML = '<p class="text-muted" style="font-size:12px;">Insights indisponíveis no momento.</p>';
    }
}

function renderAIInsights(insights) {
    const body = document.getElementById('aiInsightsBody');
    if (!body || !Array.isArray(insights)) return;
    
    const iconMap = {
        warning: 'fa-exclamation-triangle',
        success: 'fa-check-circle',
        info: 'fa-info-circle'
    };
    const colorMap = {
        warning: '#F59E0B',
        success: '#10B981',
        info: '#6C5CE7'
    };
    
    body.innerHTML = insights.map(i => `
        <div class="ai-insight-item" style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--color-border-light,#f1f5f9);">
            <i class="fas ${iconMap[i.type] || iconMap.info}" 
               style="color:${colorMap[i.type] || colorMap.info};font-size:14px;margin-top:2px;flex-shrink:0;"></i>
            <span style="font-size:12.5px;line-height:1.45;color:var(--color-text,#1e293b);">${i.text}</span>
        </div>
    `).join('');
}

