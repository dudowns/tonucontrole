# ============================================
# TONUCONTROLE - ENVIRONMENT CONFIGURATION
# ============================================
# Copie este arquivo para .env no seu ambiente local ou configure
# estas variáveis no painel de implantação/hospedagem da sua nuvem.
# NUNCA comite arquivos .env reais contendo senhas ou chaves secretas.

# --------------------------------------------
# 1. SERVIDOR & AMBIENTE
# --------------------------------------------
# Ambiente de execução: development | production | test
NODE_ENV=production

# Porta de escuta do servidor Express (padrão 3000 exigido no ambiente de container)
PORT=3000

# --------------------------------------------
# 2. SUPABASE (BANCO DE DADOS & AUTENTICAÇÃO)
# --------------------------------------------
# URL pública do projeto Supabase
SUPABASE_URL=https://rbtxrbacdpenbslqcbbl.supabase.co

# Chave anônima pública (anon key) do cliente Supabase
SUPABASE_ANON_KEY=

# --------------------------------------------
# 3. MERCADO FINANCEIRO & COTAÇÕES
# --------------------------------------------
# Token da API BRAPI (Opcional - para ampliação de cotações B3 e proventos)
BRAPI_TOKEN=

# --------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (OPCIONAL)
# --------------------------------------------
# Chave da API Google Gemini para recursos preditivos e análises inteligentes
GEMINI_API_KEY=
